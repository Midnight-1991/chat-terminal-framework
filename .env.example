# chat-terminal-framework — 环境变量示例
# 复制为 .env 后按需填写；.env 已被 .gitignore 忽略，绝不提交。
# 所有变量都可留空/删除，服务有默认值；只有 DEEPSEEK_API_KEY 需要填（或使用 CHAT_MOCK=1 离线演示）。
# 注释中的 `config.mjs:NNN` 指发布树 server/config.mjs 读取该变量的位置。

# ===== 上游模型（兼容协议）=====
DEEPSEEK_API_KEY=
#   也可不设：会回退读取 ~/.config/chat-terminal/credentials.yaml（config.mjs:252-254）
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic   # 上游地址（config.mjs:347）
# MODEL=deepseek-v4-pro                                 # 默认模型（config.mjs:345）
# MAX_TOKENS=                                           # 留空=auto；显式值覆盖全部推理档位（config.mjs:346）
# CHAT_MOCK=0                                           # 1=本地 mock 模式：不调用上游模型，用于离线演示与测试（config.mjs:350）
# UPSTREAM_TIMEOUT_MS=600000                            # 单轮上游超时（config.mjs:352）
# MOCK_DELAY_MS=8                                       # mock 模式模拟延迟（config.mjs:356）
# BACKGROUND_GENERATION=1                               # 1=离页后在后台继续生成（config.mjs:358）

# ===== 监听与服务 =====
# PORT=8787                                             # 监听端口（config.mjs:343）
# HOST=0.0.0.0                                          # 监听地址（config.mjs:344）
# SHUTDOWN_TIMEOUT_MS=5000                              # 优雅关停等待上限（server/app.mjs:276-277、bin/serve.mjs:167）
# ALLOWED_ORIGINS=                                      # CORS 允许来源，逗号分隔；空=不限制（server/app.mjs:784）

# ===== 数据目录与静态加密 =====
# DATA_DIR=./data                                       # 会话/记忆/用户等运行时数据目录（config.mjs:360，已 gitignore）
# DATA_ENCRYPTION_KEY=                                  # base64 编码 32 字节密钥：openssl rand -base64 32（config.mjs:362）
# DATA_ENCRYPTION_KEY_FILE=                             # 或指向权限 600 的密钥文件（优先于 DATA_ENCRYPTION_KEY，config.mjs:363）

# ===== 对话能力（长期记忆 / 检索 / 图片解析）=====
# MEMORY=1                                              # 1=每轮后抽取长期记忆并在后续注入（config.mjs:364）
# MEMORY_MAX=20                                         # 单次注入的记忆条数上限（config.mjs:365）
# MEMORY_EXTRACT_MODEL=                                 # 记忆抽取模型；空=同 MODEL（config.mjs:366）
# RERANK=off                                            # 检索重排：off | llm（config.mjs:371）
# QUERY_EXPAND=heuristic                                # 查询扩展：off | heuristic | llm（config.mjs:372）
# VISION_MODEL=deepseek-flash                           # 图片解析模型（config.mjs:374）
# VISION_TIMEOUT_MS=30000                               # 图片解析超时（config.mjs:375）
# VISION_MAX_TOKENS=800                                 # 图片解析输出上限（config.mjs:376）

# ===== 联网搜索（可选，默认关闭）=====
# WEBSEARCH=0                                           # 1=启用联网搜索（config.mjs:404）
# WEBSEARCH_PROVIDER=deepseek                           # 搜索提供方（config.mjs:405）
# WEBSEARCH_BASE_URL=https://api.deepseek.com           # 搜索接口地址（config.mjs:406）
# WEBSEARCH_TIMEOUT_MS=4000                             # 搜索超时（config.mjs:408）
# WEBSEARCH_COUNT=5                                     # 单次返回条数（config.mjs:414）
# WEBSEARCH_MAX_CITATIONS=2                             # 最多引用条数（config.mjs:420）
# WEBSEARCH_MIN_AUTHORITY=2                             # 来源最低权威等级（config.mjs:426）
# WEBSEARCH_MAX_AGE_DAYS=730                            # 结果最大时效（config.mjs:432）
# WEBSEARCH_CACHE_TTL_MS=3600000                        # 搜索缓存有效期（config.mjs:438）
# WEBSEARCH_CACHE_MAX=200                               # 搜索缓存条数上限（config.mjs:444）

# ===== 多用户 / 鉴权 / 配额 =====
# AUTH=off                                              # off | on；on 时启用注册登录、配额与管理后台（config.mjs:451）
# AUTH_COOKIE_SECURE=1                                  # 1=Cookie 带 Secure（生产 HTTPS 必须开；本地 http 联调可设 0，config.mjs:452）
# AUTH_SESSION_TTL_DAYS=7                               # 登录会话有效期（config.mjs:454）
# ADMIN_USERNAME=admin                                  # 管理员用户名（config.mjs:459）
# ADMIN_INITIAL_PASSWORD_FILE=                          # 管理员初始密码文件路径（首次启动读取；文件勿提交，config.mjs:460）
# INVITE_ONLY=1                                         # 1=仅邀请注册（config.mjs:461）
# QUOTA_DAY_TOKENS=200000                               # 每用户每日 token 配额（config.mjs:464）
# QUOTA_MONTH_TOKENS=2000000                            # 每用户每月 token 配额（config.mjs:470）
# RATE_PER_MINUTE=20                                    # 每用户每分钟请求上限（config.mjs:478）
# RATE_CONCURRENCY=2                                    # 每用户并发请求上限（config.mjs:484）
# USAGE_RETENTION_DAYS=180                              # 用量记录保留天数（config.mjs:496）
# FEEDBACK_MAX_CHARS=2000                               # 反馈内容长度上限（config.mjs:502）
# ALLOWED_MODELS=deepseek-v4-pro,deepseek-v4-flash      # 允许使用的模型列表，逗号分隔（config.mjs:490）
# PRICE_VERSION=2026-11-06                              # 价格表版本号（config.mjs:491）
# PRICE_TABLE_JSON=                                     # 自定义价格表 JSON（完整覆盖默认表，config.mjs:492）

# ===== 自评问卷历史（可选扩展；引擎内置 1 个演示问卷）=====
# SCALE_HISTORY=1                                       # 1=保存结果摘要（不存原始答案与题面，config.mjs:395）
# SCALE_HISTORY_INJECT=1                                # 1=对话中注入历史结果作为背景参考（config.mjs:396）
# SCALE_HISTORY_RETENTION_DAYS=730                      # 结果摘要保留天数（config.mjs:398-401）

# ===== 记录导入（可选扩展，默认关闭外部写入）=====
# HEALTH_IMPORT=1                                       # 1=开放记录导入接口（config.mjs:379）
# HEALTH_INJECT=1                                       # 1=把导入记录注入对话背景（config.mjs:380）
# HEALTH_RETENTION_DAYS=180                             # 导入记录保留天数（config.mjs:381）
# HEALTH_IMPORT_TOKEN=                                  # 只读导入 token；留空=不校验（勿提交，config.mjs:385）

# ===== 附件 =====
# ATTACHMENT_STORAGE=1                                  # 1=附件二进制持久化到 DATA_DIR/attachments（config.mjs:387）
# ATTACHMENT_MAX_MB=512                                 # 附件目录总容量上限（config.mjs:389-392）
# ATTACHMENT_RETENTION_DAYS=0                           # 附件保留天数；0=不清理（config.mjs:561）

# ===== BYOK：多厂商自定义模型接入（默认开启）=====
# BYOK=1                                                # 1=允许用户配置自己的模型服务（config.mjs:514）
# BYOK_ALLOW_LOOPBACK=0                                 # 1=允许回环地址（config.mjs:515）
# BYOK_CHECK_PER_MINUTE=3                               # 地址连通性检查频率（config.mjs:517）
# BYOK_TIMEOUT_MS=120000                                # 自定义上游超时（config.mjs:523）
# BYOK_MAX_KEY_CHARS=512                                # API Key 最大长度（config.mjs:529）
# BYOK_MAX_MODEL_CHARS=128                              # 模型名最大长度（config.mjs:535）
# BYOK_MAX_BASEURL_CHARS=512                            # 服务地址最大长度（config.mjs:541）
# BYOK_CHECK_ENABLED=1                                  # 1=启用地址连通性检查（config.mjs:567）
# BYOK_ALLOWED_MODELS=                                  # 允许的模型名清单，逗号分隔（config.mjs:568）
# BYOK_ALLOWED_HOSTS=                                   # 允许访问的服务主机清单，逗号分隔（config.mjs:569）

# ===== 官方模型峰谷策略（可选）=====
# PEAK_MODEL_POLICY=off                                 # off | auto（config.mjs:570）
# PEAK_MODEL=deepseek-v4-flash                          # 峰时使用的模型（config.mjs:571）
# PEAK_HOURS_UTC=01:00-04:00,06:00-10:00                # 峰时段（UTC，逗号分隔，config.mjs:572）

# ===== 本机工具（可选）=====
# CHROME_PATH=                                          # 生成站点图标时使用的本机浏览器路径（scripts/gen-icons.mjs:71）
